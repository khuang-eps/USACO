//package daisychains;

import java.util.*;
import java.io.*;

public class daisychains {
	public static void main(String[] args) throws Exception {
//		Scanner in = new Scanner(new File("daisychains.in"));
		Scanner in = new Scanner(System.in);
		int N = Integer.parseInt(in.next());
		int[] flowers = new int[N];
		for (int i = 0; i < N; i++) {
			flowers[i] = Integer.parseInt(in.next());
		}
		in.close();
		
		int pics = 0;
		for (int i = 0; i < N; i++) {
			for (int j = i; j < N; j++) {
				float avg = 0;
				int div = 0;
				for (int k = i; k <= j; k++) {
					avg += flowers[k];
					div++;
				}
				avg /= div;
				
				for (int k = i; k <= j; k++) {
					if (flowers[k] == avg) {
						pics++;
						break;
					}
				}
			}
		}
		
		PrintWriter out = new PrintWriter(new File("daisychains.out"));
		System.out.println(pics);
		out.close();
	}
}
