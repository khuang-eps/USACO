//package photo;

import java.util.*;
import java.io.*;

public class photo {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("photo.in"));
		int n = Integer.parseInt(in.next());
		int[] b = new int[n - 1];
		for (int i = 0; i < n - 1; i++) {
			b[i] = Integer.parseInt(in.next());
		}
		in.close();
		
		int[] a = new int[n];
		for (int i = 1; i < b[0]; i++) {
			HashSet<Integer> set = new HashSet<>();

			a[0] = i;
			set.add(a[0]);
			for (int j = 1; j < n; j++) {
				a[j] = b[j - 1] - a[j - 1];
				if (a[j] <= 0 || set.contains(a[j])) {
					break;
				}
				set.add(a[j]);
			}
			
			if (set.size() == n) {
				break;
			}
		}
		
		PrintWriter out = new PrintWriter(new File("photo.out"));
		String res = "";
		for (int x : a) {
			res += x + " ";
		}
		res = res.substring(0, res.length() - 1);
		System.out.println(res);
		out.println(res);
		out.close();
	}
}
