import java.util.*;
import java.io.*;

public class acowdemia3 {
	class Point {
		int x;
		int y;
		
		Point(int x, int y) {
			this.x = x;
			this.y = y;
			
		}
	}
	
	public static void main(String[] args) throws Exception {
//		Scanner in = new Scanner(new File("acowdemia3.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next());
		int m = Integer.parseInt(in.next());
		
		int[][] grid = new int[n][m];
		
		for (int r = 0; r < n; r++) {
			String row = in.next();
			for (int c = 0; c < m; c++) {
				grid[r][c] = row.charAt(c);
			}
		}		
		in.close();
		
		int res = 0;
		
		acowdemia3 acow = new acowdemia3();
		Comparator comparator = new Comparator<Point>() {
			@Override
			public int compare(Point o1, Point o2) {
				if (o1.x > o2.x) {
					return 1;
				} else if (o1.x < o2.x) {
					return -1;
				} else if (o1.y > o2.y) {
					return 1;
				} else if (o1.y < o2.y) {
					return -1;
				}
				return 0;
			}
		};
		
		
		HashSet<ArrayList<Point>> cset = new HashSet<>();
		for (int r = 0; r < n; r++) {
			for (int c = 0; c < m; c++) {
				if (grid[r][c] == 'G') { // grass
					ArrayList<Point> clist = new ArrayList<>();
					ArrayList<Point> cpair = new ArrayList<>();
					
					int[] dx = {-1, 0, 1, 0};
					int[] dy = {0, -1, 0, 1};
					
					for (int t = 0; t < 4; t++) {
						int nx = r + dx[t];
						int ny = c + dy[t];
						if (nx >= 0 && nx < n && ny >= 0 && ny < m && grid[nx][ny] == 'C') { // in-bounds + is c
							clist.add(acow.new Point(nx, ny));
//							System.out.println("G:  r: " + r + " c: " + c);
//							System.out.println("clist: " + nx + " " + ny);
						}
					}
					
					if (clist.size() == 2) {
						clist.sort(comparator);
						
						boolean same = false;
						for (ArrayList<Point> arr : cset) {
							if (comparator.compare(arr.get(0), clist.get(0)) == 0 && comparator.compare(arr.get(1), clist.get(1)) == 0) { // same arrlist
								same = true;
							}
						}
						
						if (!same) {cset.add(clist);} // add if different
						
//						System.out.println("size = 2, x1: " + clist.get(0).x + " y1: " + clist.get(0).y + "  x2: " + clist.get(1).x + " y2: " + clist.get(1).y);
					} else if (clist.size() > 2) {
						res++;
//						System.out.println(">2");
					}
				}
			}
		}
		
		res += cset.size();
//		System.out.println("cset size: " + cset.size());
		
		System.out.println(res);
	}
	//
}



