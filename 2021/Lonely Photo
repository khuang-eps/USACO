import java.util.*;
import java.io.*;

public class lonelyphoto {
	public static void solution1() throws Exception {
//		Scanner in = new Scanner(new File("lonelyphoto.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next());
		char[] cows = new char[n];
		String s = in.next();
		for (int i = 0; i < n; i++) {
			cows[i] = s.charAt(i);
		}
		in.close();
		
		long res = 0;
		
		for (int i = 0; i < n; i++) {
			int g = 0;
			int h = 0;
			
			if (cows[i] == 'G') {
				g++;
			} else {
				h++;
			}
			
			for (int j = i + 1; j < n; j++) {
				if (cows[j] == 'G') {
					g++;
				} else {
					h++;
				}
				
				if (j - (i - 1) >= 3 && (g == 1 || h == 1)) {
					res++;
				}
			}
		}
		
		System.out.println(res);
	}
	
	public static void solution2() throws Exception {
//		Scanner in = new Scanner(new File("lonelyphoto.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next());
		char[] cows = new char[n];
		String s = in.next();
		for (int i = 0; i < n; i++) {
			cows[i] = s.charAt(i);
		}
		in.close();
		
		long res = 0;
		long rhs = 0;
		long lhs = 0;
		
		for (int i = 1; i + 1 < n; i++) {
			if (cows[i] != cows[0] && cows[i + 1] != cows[0]) {
				rhs++;
			} else {
				break;
			}
		}
		if (rhs > 0) {
			res += rhs;
		}
		
		
		for (int i = n - 2; i - 1 >= 0; i--) {
			if (cows[i] != cows[n - 1] && cows[i - 1] != cows[n - 1]) {
				lhs++;
			} else {
				break;
			}
		}
		if (lhs > 0) {
			res += lhs;
		}
		
		for (int i = 1; i < n - 1; i++) {
			lhs = 0;
			rhs = 0;
			
			if (cows[i] != cows[i - 1]) {
				for (int j = i - 1; j >= 0; j--) { // left
					if (cows[j] == cows[i - 1]) {
						lhs++;
					} else {
						break;
					}
				}
				
			}
			if (cows[i] != cows[i + 1]) {
				for (int j = i + 1; j < n; j++) { // right
					if (cows[j] == cows[i + 1]) {
						rhs++;
					} else {
						break;
					}
				}
			}
			
			
			if (lhs > 0) {
				res += lhs - 1;
			}
			if (rhs > 0) {
				res += rhs - 1;
			}
			res += lhs * rhs;
		}
		
		
		System.out.println(res);
	}
	public static void main(String[] args) throws Exception {
//		solution1();
		solution2();
	}

}
