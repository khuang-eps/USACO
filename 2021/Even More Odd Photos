//package evenmore_oddphotos;

import java.util.*;
import java.io.*;

public class evenmore_oddphotos {
	public static void main(String[] args) throws Exception {
//		Scanner in = new Scanner(new File("evenmore_oddphotos.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next());
		
		ArrayList<Integer> e = new ArrayList<>();
		ArrayList<Integer> o = new ArrayList<>();
		for (int i = 0; i < n; i++) {
			int num = Integer.parseInt(in.next());
			if (num % 2 == 0) { // even
				e.add(num);
			} else { // odd
				o.add(num);
			}
		}
		in.close();
		
		int res = 0;
		
		if (e.size() == o.size() || e.size() == o.size() + 1) {
			res = e.size() + o.size();
		} else if (e.size() > o.size() + 1){ // more even than odd
			res = o.size() * 2 + 1;
		} else if (e.size() < o.size()) { // more odd than even
			if ((o.size() - e.size()) % 3 == 0) {
				res = e.size() * 2 + ((o.size() - e.size()) / 3) * 2;
			}
			if ((o.size() - e.size()) % 3 == 1) {
				res = e.size() * 2 + ((o.size() - e.size()) / 3) * 2 - 1;
			} if ((o.size() - e.size()) % 3 == 2) {
				res = e.size() * 2 + ((o.size() - e.size()) / 3) * 2 + 1;
			}
		}
		
		System.out.println(res);
	}
}
