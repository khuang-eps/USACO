//package speeding;

import java.util.*;
import java.io.*;

public class speeding {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("speeding.in"));
		int N = Integer.parseInt(in.next()); // speed limit segments
		int M = Integer.parseInt(in.next()); // bessie's segments
		
		int[] n = new int[101];
		int[] m = new int[101];
		int pos = 1;
		for (int i = 0; i < N; i++) {
			int len = Integer.parseInt(in.next()); // length of current segment
			int limit = Integer.parseInt(in.next()); // speed limit of current segment
			
			for (int j = pos; j < pos + len; j++) {
				n[j] = limit;
			}
			
			pos += len;	
		}
		
		pos = 1;
		for (int i = 0; i < M; i++) {
			int len = Integer.parseInt(in.next()); // length of current segment
			int limit = Integer.parseInt(in.next()); // speed limit of current segment
			
			for (int j = pos; j < pos + len; j++) {
				m[j] = limit;
			}
			
			pos += len;	
		}
		in.close();
		
		int res = 0;
		for (int i = 1; i <= 100; i++) {
			if (m[i] > n[i]) {
				if (m[i] - n[i] > res) {
					res = m[i] - n[i];
				}
			}
		}
		
		PrintWriter out = new PrintWriter(new File("speeding.out"));
		System.out.println(res);
		out.println(res);
		out.close();
	}
}
