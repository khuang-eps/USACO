        for (int i = 0; i < n; i++) {
            wormholes[i][0] = sc.nextInt();
            wormholes[i][1] = sc.nextInt();
        }
        sc.close();
        
        // Arrays.sort(wormholes, (a,b) -> a[1] - b[1]);
        // the -> notation is part of a lambda expression
        // in this case, the lambda result is assumed to be returned
        //    on the only line inside the method in the class being defined
        
        Arrays.sort(wormholes,  (a,b) -> {
            int dy = a[1] - b[1];
            if (dy == 0) return a[0] - b[0];
            //                a.x=7    b.x=9    => -2   for example
            return dy;
        });
        // this expression defines and instantiates a class implementing an
        //    interface with the specified method definition
    
        int[] links = new int[n];
        Arrays.fill(links, -1);
        int result = countCyclicalArrangments(0, links);
        
        // ex. link-tracking array
        //         {-1, -1, -1, -1, -1, ...}
        //           0   1   2   ...
        //           ^
        //         first func call input
        
        //         {3, 2, 1, 0, 7, ......., 4, ....}
        
        //          0  1  2  3  4  5        7
        //                         ^
        //                     next func call input
        
        PrintWriter pw = new PrintWriter(new File("wormhole.out"));
        System.out.println(result);
        pw.println(result);
        pw.close();
    }
    
