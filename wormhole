



import java.util.*;
import java.io.*;

public class wormhole {
    // public is not necessary, since even non-public elements
    //   are visible within the class (and within the package, if not private)
    static int[][] wormholes;   // default value: null
    // static makes it so
    //    - the element can be referenced without naming a specific object
    //    - the element IS associated with the class itself
    //          - outside the class, you must name the class, then the method
    //                 Arrays.sort          Math.abs
    //          - inside the class, it's assumed any method call without a named
    //              class is assumed to be either a static or instance method
    //              from that class
    //          - inside a static method, you can't access instance vars/methods
    //              without specifying an instance, but you can access static vars
    //              and methods
    
    public static void main(String[] args) throws Exception {
        Scanner sc = new Scanner(new File("wormhole.in"));
        int n = sc.nextInt();
        
        wormholes = new int[n][2];
        // row #: wormhole id #
        // col #: 0 => x, 1 => y   (of that wormhole)
        
