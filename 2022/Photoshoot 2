//package photo2;

import java.util.*;
import java.io.*;

public class photo2 {
	public static void main(String[] args) throws Exception {
//		Scanner in = new Scanner(new File("photo2.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next());
		ArrayList<Integer> a = new ArrayList<>();
		ArrayList<Integer> b = new ArrayList<>();
		
		for (int i = 0; i < n; i++) {
			a.add(Integer.parseInt(in.next()));
		}
		for (int i = 0; i < n; i++) {
			b.add(Integer.parseInt(in.next()));
		}
		in.close();
		
		int res = 0;
		
		HashMap<Integer, Integer> pos = new HashMap<>();
		HashMap<Integer, Integer> ind = new HashMap<>();
		
		for (int i = 0; i < n; i++) {
			ind.put(b.get(i), i);
		}
		
		for (int i = 0; i < n; i++) {
			pos.put(a.get(i), ind.get(a.get(i)));
		}
		
		int max = 0;
		for (int i : a) {
			if (pos.get(i) > max) {
				max = pos.get(i);
			}
			
			if (pos.get(i) < max) {
				res++;
			}
		}
		
		System.out.println(res);
	}
}
