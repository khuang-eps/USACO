//package traffic;

import java.util.*;
import java.io.*;

public class traffic {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("traffic.in"));
		int n = Integer.parseInt(in.next());
		String[] type = new String[n]; // type of segment (on, none, off)
		int[] min = new int[n];
		int[] max = new int[n];
		
		for (int i = 0; i < n; i++) {
			type[i] = in.next();
			min[i] = Integer.parseInt(in.next());
			max[i] = Integer.parseInt(in.next());
		}
		in.close();
		
		int pos = 0;
		// before
		int b1 = 0;
		int b2 = 0;
		// after
		int a1 = 0;
		int a2 = 0;
		
		int first = 0;
		int last = 0;
		// find mile of first and last "none"
		for (int i = 0; i < n; i++) {
			if (type[i].equals("none")) {
				first = i;
				break;
			}
		}
		for (int i = n - 1; i >= 0; i--) {
			if (type[i].equals("none")) {
				last = i;
				break;
			}
		}
		
		a1 = min[first];
		a2 = max[first];
		b1 = min[last];
		b2 = max[last];
		// find rate range before mile 1
		for (int i = last; i >= 0; i--) {
			if (type[i].equals("none")) {
				b1 = Math.max(b1, min[i]);
				b2 = Math.min(b2, max[i]);
				
			} else if (type[i].equals("on")) {
				b1 -= max[i];
				b2 -= min[i];
			} else if (type[i].equals("off")) {
				b1 += min[i];
				b2 += max[i];
			}
			
			if (b1 < 0) {
				b1 = 0;
			}
			if (b2 < 0) {
				b2 = 0;
			}
		}
		
		// find rate range after mile n
		for (int i = first; i < n; i++) {
			if (type[i].equals("none")) {
				a1 = Math.max(a1, min[i]);
				a2 = Math.min(a2, max[i]);
				
			} else if (type[i].equals("on")) {
				a1 += min[i];
				a2 += max[i];
			} else if (type[i].equals("off")) {
				a1 -= max[i];
				a2 -= min[i];
			}
			
			if (a1 < 0) {
				a1 = 0;
			}
			if (a2 < 0) {
				a2 = 0;
			}
		}
		
		PrintWriter out = new PrintWriter(new File("traffic.out"));
		System.out.println(b1 + " " + b2);
		System.out.println(a1 + " " + a2);
		out.println(b1 + " " + b2);
		out.println(a1 + " " + a2);
		out.close();
	}
	
}
