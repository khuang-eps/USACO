//package mooloo;

import java.util.*;
import java.io.*;

public class mooloo {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next()); // # of days
		int k = Integer.parseInt(in.next());
		long[] d = new long[n]; // days bessie watches mooloo
		for (int i = 0; i < n; i++) {
			d[i] = Long.parseLong(in.next());
		}
		in.close();
		
		long sum = 1 + k;
		for (int i = 1; i < n; i++) {
			sum += Math.min(1 + k, d[i] - d[i - 1]);
		}
		
		System.out.println(sum);
	}
}
