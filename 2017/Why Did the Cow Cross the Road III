//package cowqueue;

import java.util.*;
import java.io.*;

public class cowqueue {
	class Pair {
		int at; // arrival time
		int qt; // questioning time
		
		Pair(int at, int qt) {
			this.at = at;
			this.qt = qt;
		}
	}
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("cowqueue.in"));
		int n = Integer.parseInt(in.next());
		int[] arrive = new int[n];
		int[] question = new int[n];
		
		for (int i = 0; i < n; i++) {
			arrive[i] = Integer.parseInt(in.next());
			question[i] = Integer.parseInt(in.next());
		}
		in.close(); 
		
		cowqueue cq = new cowqueue();
		Comparator comparator = new Comparator<Pair>() {
			@Override
			public int compare(Pair c1, Pair c2) {
				if (c1.at > c2.at) {
					return 1;
				} else if (c1.at < c2.at) {
					return -1;
				}
				return 0;
			}
		};
		
		
		ArrayList<Pair> cows = new ArrayList<>();
		for (int i = 0; i < n; i++) {
			cows.add(cq.new Pair(arrive[i], question[i]));
		}
		cows.sort(comparator);
		
		int time = 0;
		for (int i = 0; i < n; i++) {
			time = Math.max(time, cows.get(i).at) + cows.get(i).qt;
		}
		
		PrintWriter out = new PrintWriter(new File("cowqueue.out"));
		System.out.println(time);
		out.println(time);
		out.close();
	}
}
