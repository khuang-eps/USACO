//package cowtip;

import java.util.*;
import java.io.*;

public class cowtip {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("cowtip.in"));
		int n = Integer.parseInt(in.next());
		int[][] cows = new int[n][n];
		for (int r = 0; r < n; r++) {
			String temp = in.next();
			int[] row = new int[n];
			
			for (int c = 0; c < n; c++) {
				cows[r][c] = temp.charAt(c) - '0';
			}
		}
		in.close();
		
		int res = 0;
		for (int r = n - 1; r >= 0; r--) {
			for (int c = n - 1; c >= 0; c--) {
				if (cows[r][c] == 1) {
					for (int a = 0; a <= r; a++) {
						for (int b = 0; b <= c; b++) {
							
							cows[a][b] = 1 - cows[a][b];
						}
					}
					res++;
				}
			}
		}
		
		PrintWriter out = new PrintWriter(new File("cowtip.out"));
		System.out.println(res);
		out.println(res);
		out.close();
	}
}
