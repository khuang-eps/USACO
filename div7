package div7;

import java.util.*;
import java.io.*;

public class div7 {
	public static void main(String[] args) throws Exception {
		System.out.println(System.getProperty("user.dir"));
		Scanner in = new Scanner(new File("div7.in"));
		int n = Integer.parseInt(in.next());
		int[] start = new int[7];
		int[] end = new int[7];
		
		long psum = 0;
		
		for (int i = 0; i < start.length; i++) {
			start[i] = Integer.MAX_VALUE;
		}
		
		for (int i = 1; i <= n; i++) {
			psum += Integer.parseInt(in.next());
			
			int rem = (int) (psum % 7);
			start[rem] = Math.min(start[rem], i); // earliest element with that remainder
			
			end[rem] = Math.max(end[rem], i); // last element
		}
		
		int res = 0;
		for (int i = 0; i < 7; i++) {
			if (start[i] <= n) {
				res = Math.max(end[i] - start[i], res);
			}
		}
		in.close();
		
		
		
		PrintWriter out = new PrintWriter(new File("div7.out"));
		out.println(res);
		out.close();
	}
}
