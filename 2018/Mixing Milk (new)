//package mixmilk;

import java.util.*;
import java.io.*;

public class mixmilk {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("mixmilk.in"));
		int[] c = new int[3];
		int[] m = new int[3];
		for (int i = 0; i < 3; i++) {
			c[i] = Integer.parseInt(in.next());
			m[i] = Integer.parseInt(in.next());
		}
		in.close();
		
		// simulate problem
		for (int i = 0; i < 100; i++) { // pour milk 100 times
			m[(i + 1) % 3] += m[i % 3]; // pour all milk from current bucket into next bucket
			m[i % 3] = 0; // current bucket would be empty
			if (m[(i + 1) % 3] > c[(i + 1) % 3]) { // milk exceeds capacity
				m[i % 3] = m[(i + 1) % 3] - c[(i + 1) % 3]; // current bucket = excess milk
				m[(i + 1) % 3] = c[(i + 1) % 3]; // set next bucket's value to capacity
			}
		}
		
		PrintWriter out = new PrintWriter(new File("mixmilk.out"));
		for (int i = 0; i < 3; i++) {
			out.println(m[i]);
			System.out.println(m[i]);
		}
		
		out.close();
	}
}
