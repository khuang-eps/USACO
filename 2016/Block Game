//package blockgame;

import java.util.*;
import java.io.*;

public class blocks {
	public static void main(String[] args) throws Exception {
		Scanner in = new Scanner(new File("blocks.in"));
		int n = Integer.parseInt(in.next());
		
		int[] res = new int[26];
		
		for (int i = 0; i < n; i++) {
			int[] a = new int[26];
			int[] b = new int[26];
			String sa = in.next(); // side 1
			String sb = in.next(); // side 2
			
			for (int j = 0; j < sa.length(); j++) {
				a[sa.charAt(j) - 'a']++;
			}
			for (int j = 0; j < sb.length(); j++) {
				b[sb.charAt(j) - 'a']++;
			}
			
			for (int j = 0; j < 26; j++) {
				res[j] += Math.max(a[j], b[j]);
			}
		}
		in.close();
		
		
		
		PrintWriter out = new PrintWriter(new File("blocks.out"));
		for (int i : res) {
			System.out.println(i);
			out.println(i);
		}
		out.close();
	}
}
