import java.util.*;
import java.io.*;

public class maxproduct {
	public static void main(String[] args) throws Exception {
//		Scanner in = new Scanner(new File("maxproduct.in"));
		Scanner in = new Scanner(System.in);
		int n = Integer.parseInt(in.next()); // # of farms
		int q = Integer.parseInt(in.next()); // # of queries
		
		// closing time of each farm
		int[] c = new int[n];
		for (int i = 0; i < n; i++) {
			c[i] = Integer.parseInt(in.next());
		}
		// time after Bessie wakes up
		int[] t = new int[n];
		for (int i = 0; i < n; i++) {
			t[i] = Integer.parseInt(in.next());
		}
		
		int[] b = new int[n]; // Ci - Ti - time between bessie's arrival time and farm's closing time
		for (int i = 0; i < n; i++) {
			b[i] = c[i] - t[i];
		}
		Arrays.sort(b);
		for (int i : b) {
//			System.out.println("b: " + i);
		}
		
		for (int i = 0; i < q; i++) {
			int v = Integer.parseInt(in.next());
			int s = Integer.parseInt(in.next());
			
			int cv = b.length - findPivot(b, s); // can visit
//			System.out.println(cv);
			if (cv == b.length + 1) {
				System.out.println("NO");
			} else if (cv >= v) {
				System.out.println("YES");
			} else {
				System.out.println("NO");
			}
		}
		
		in.close();
	}
	
	// pivot: point where all elements after it can be visited within closing time
	public static int findPivot(int[] b, int s) { 
		int res = -1;
		
		int start = 0;
		int end = b.length - 1;
		while (start <= end) {
			int mid = (start + end) / 2; // find midpoint of the range of numbers
			if (b[mid] <= s) { // not enough time between bessie's wake up time and closing time
				start = mid + 1; // increase range value
//				res = start;
			} else { // more than enough time for bessie to arrive
				//at this point, b[mid] > s, and b[mid - 1] <= s. b[mid] is the 1st elem > s
				if (mid - 1 >= 0 && mid - 1 < b.length && b[mid - 1] <= s) {
					res = mid;
					break;
				}
				end = mid - 1; // decrease range value
				
			}
		}
		
		return res;
	}
}
